{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "types": [
      "node",
      "vitest/globals"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
